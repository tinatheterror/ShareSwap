# Names only; real values live in Replit Secrets. Copy to .env for local work.

# Account deletion -----------------------------------------------------------
# Secret key for the keyed hash (HMAC-SHA256) that blocks a banned person's email from signing up again after their
# account is deleted. Required: deleting a banned account fails without it. Use a long random value (for example
# `openssl rand -hex 32`) and never change it once accounts have been deleted, or the stored hashes stop matching.
BANNED_EMAIL_HASH_KEY=

# What the job that deletes accounts after their 14-day grace period does when no job_switches row says otherwise:
# off (default), dry-run (only counts what it would delete) or live. Must be live before store submission.
ACCOUNT_DELETION_FINALIZE_MODE=off
